# Customer-facing pricing
# COST feeds are published only when an enabled rule matches.
PRICING_RULES_PATH=/data/pricing-rules.json
ADMIN_PRICING_TOKEN=
SALE_PRICE_ROUNDING=1000
OFFER_TTL_HOURS=24
SYNC_INTERVAL_MINUTES=15
SOURCE_STATUS_PATH=/tmp/charter-source-status.json
TELEGRAM_SOURCE_CHANNELS=
TELEGRAM_SOURCE_TTL_HOURS=24
TELEGRAM_SOURCE_MAX_PAGES=6
TELEGRAM_REPUBLISH_SOURCE_FEEDS=false

# NEOS Google Sheet cost currency. Leave blank only if the sheet itself contains
# one unambiguous explicit marker: KZT/₸/тенге, USD, or EUR/€/евро.
# Numeric price size is never used to guess currency.
NEOS_SOURCE_CURRENCY=
FX_USD_KZT=
FX_EUR_KZT=

# SAMO ticket API automation.
# The official ticket API requires a partner-issued API token and, depending on the operator,
# the server IP may also need to be whitelisted by the operator/SAMO support.
SAMO_ORIGIN_IATA=ALA,NQZ
SAMO_TARGET_IATA=CXR,PQC,DAD,BKK,HKT,SYX
SAMO_CURRENCY_PREFERENCE=KZT,USD,EUR
SAMO_SEARCH_HORIZON_DAYS=60
SAMO_RT_NIGHTS=7,10,14
SAMO_INCLUDE_REGULAR=false
SAMO_MAX_ROUTES_PER_SOURCE=12
SAMO_REQUEST_DELAY_MS=200
SAMO_REQUEST_TIMEOUT_MS=15000

KAZUNION_SAMO_API_TOKEN=
CRYSTAL_BAY_SAMO_API_TOKEN=
ABK_SAMO_API_TOKEN=

# B2B partner credentials.
# Store real values as GitHub Actions Secrets / Railway secrets; never commit them.
FUN_SUN_USERNAME=
FUN_SUN_PASSWORD=
KAZUNION_USERNAME=
KAZUNION_PASSWORD=
KOMPAS_USERNAME=
KOMPAS_PASSWORD=
ANEX_USERNAME=
ANEX_PASSWORD=
SELFIE_USERNAME=
SELFIE_PASSWORD=
JOINUP_USERNAME=
JOINUP_PASSWORD=
PEGAS_USERNAME=
PEGAS_PASSWORD=
CRYSTAL_BAY_USERNAME=
CRYSTAL_BAY_PASSWORD=
ABK_USERNAME=
ABK_PASSWORD=
SPACE_USERNAME=
SPACE_PASSWORD=
VIETRA_USERNAME=
VIETRA_PASSWORD=
SANAT_USERNAME=
SANAT_PASSWORD=

# Customer handoff
VITE_MANAGER_WHATSAPP=77007772414

# Telegram Bot + Mini App
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
ADMIN_TELEGRAM_IDS=
TELEGRAM_PUBLISH_ENABLED=true
TELEGRAM_PUBLISH_STATE_PATH=/data/telegram-publications.json
TELEGRAM_PUBLICATION_RETENTION_DAYS=30
TELEGRAM_PUBLISH_CHATS=-1002106608923,-1002285584868
MAX_POSTS_PER_RUN=3
POST_DELAY_SECONDS=2
PUBLIC_APP_URL=https://charter-app-production-6bf5.up.railway.app
