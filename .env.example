# Telegram-only charter ingestion
# Public channel handles, comma-separated. @ and t.me links are accepted.
# Six built-in defaults are enabled even when this variable is empty:
# charter_forever_travel, bilettu, biletuu, avia07, chartersavia, charter_antalya
TELEGRAM_SOURCE_CHANNELS=
TELEGRAM_SOURCE_TTL_HOURS=24
TELEGRAM_SOURCE_MAX_PAGES=6
SYNC_INTERVAL_MINUTES=15
SOURCE_STATUS_PATH=/tmp/charter-source-status.json

# Customer-facing pricing
PRICING_RULES_PATH=/data/pricing-rules.json
ADMIN_PRICING_TOKEN=
SALE_PRICE_ROUNDING=1000
OFFER_TTL_HOURS=24
# Same-day opposite OW routes are independently validated and may both be valid.
ALLOW_CACHED_FALLBACK=false
CACHED_FALLBACK_MAX_AGE_HOURS=72
CACHED_FALLBACK_TTL_HOURS=6
CACHED_FALLBACK_MAX_FLIGHTS=80

# Customer handoff
VITE_MANAGER_WHATSAPP=77007772414

# Telegram Bot + Mini App publication
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
ADMIN_TELEGRAM_IDS=
TELEGRAM_PUBLISH_ENABLED=true
TELEGRAM_PUBLISH_STATE_PATH=/data/telegram-publications.json
# Runtime-private provenance snapshot. Railway requires /data mounted to one persistent volume.
FLIGHT_OBSERVATION_STATE_PATH=/data/flight-observations.json
# All sync entry points must use the same lock path (one Railway replica).
FLIGHT_SYNC_LOCK_PATH=/data/flight-sync.lock
# Detailed source diagnostics only; default production logs contain counts.
DEBUG_FLIGHT_SYNC=false
TELEGRAM_PUBLICATION_RETENTION_DAYS=30
TELEGRAM_REPUBLISH_COOLDOWN_HOURS=24
TELEGRAM_MIN_PUBLISH_INTERVAL_MINUTES=15
TELEGRAM_PUBLISH_TIMEZONE=Asia/Almaty
TELEGRAM_PUBLISH_START_HOUR=10
TELEGRAM_PUBLISH_END_HOUR=20
# One complete post per country is sent once in the morning; later only new hot flights are posted.
TELEGRAM_DAILY_DIGEST_START_HOUR=10
TELEGRAM_DAILY_DIGEST_END_HOUR=12
# Optional one-day catch-up, e.g. 2026-10-01. Leave empty normally.
TELEGRAM_DIGEST_CATCHUP_DATE=
TELEGRAM_PUBLISH_CHATS=-1002106608923,-1002285584868
MAX_POSTS_PER_RUN=2
POST_DELAY_SECONDS=2
PUBLIC_APP_URL=https://charter-app-production-6bf5.up.railway.app
