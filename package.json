{
  "name": "kazakh-vietnam-ai",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "check:runtime": "node scripts/check-mobile-runtime.mjs",
    "update:runtime-lock": "node scripts/update-mobile-runtime-lock.mjs",
    "pretest:runtime": "npm run check:runtime",
    "test:runtime": "node tests/run-runtime-tests.mjs",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "predev": "npm run check:runtime",
    "dev": "vite",
    "prebuild": "npm run check:runtime",
    "build": "tsc && vite build && node scripts/prepare-sites-build.mjs",
    "lint": "oxlint src/Prototype.tsx",
    "typecheck": "tsc --noEmit",
    "test": "node tests/flight-app.test.mjs",
    "sync:flights": "node scripts/sync-all-sources.mjs",
    "sync:public-telegram": "node scripts/sync-public-flights.mjs",
    "start": "node scripts/serve-dist.mjs",
    "test:pricing": "node tests/pricing-engine.test.mjs",
    "test:telegram": "node tests/telegram-bot.test.mjs",
    "test:admin-auth": "node tests/telegram-admin-auth.test.mjs",
    "test:publisher": "node --test tests/charter-geo.test.mjs tests/telegram-digest.test.mjs tests/telegram-schedule.test.mjs tests/telegram-publication-state.test.mjs tests/telegram-publisher.test.mjs tests/telegram-publish-run.test.mjs tests/charter-publication-policy.test.mjs",
    "test:lifecycle": "node tests/offer-lifecycle.test.mjs",
    "test:sources": "node --test tests/source-registry.test.mjs tests/telegram-source-adapter.test.mjs tests/telegram-channel-discovery.test.mjs tests/flight-validator.test.mjs && node tests/cached-flight-fallback.test.mjs",
    "test:pipeline": "node --test tests/telegram-publication-pipeline.test.mjs",
    "publish:dry-run": "node scripts/telegram-publish-dry-run.mjs",
    "publish:test-chat": "node scripts/telegram-publish-dry-run.mjs --send-test",
    "test:policy": "node --test tests/charter-publication-policy.test.mjs",
    "test:all": "npm run test:publisher && npm run test:sources && npm run test:pipeline && npm run test:lifecycle && npm run test:pricing && npm run test:telegram && npm run test:admin-auth"
  },
  "dependencies": {
    "@fontsource/roboto": "5.2.10",
    "@radix-ui/react-dialog": "1.1.19",
    "@radix-ui/react-dropdown-menu": "2.1.20",
    "@radix-ui/react-icons": "1.3.2",
    "@use-gesture/react": "10.3.1",
    "motion": "12.42.2",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "teleproto": "1.229.1"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "oxlint": "^1.85.0",
    "typescript": "7.0.2",
    "vite": "8.1.3"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
